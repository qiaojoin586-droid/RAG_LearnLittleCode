# ========== 模型提供商（一键切换） ==========
# 可选值: dashscope（阿里云百炼）/ ollama（本地）
# 说明: openai 属于规划中能力，代码接入改造完成前请勿设为 openai
#       （改造方案见 docs/DashScope迁移OpenAI大模型接入设计方案.md）
# 切换后需重启服务；若切换 Embedding 提供商，还需重建 ChromaDB 向量,需要删除先前创建的向量并且进行重建向量库
MODEL_PROVIDER=

# ========== DashScope（阿里云百炼） ==========
DASHSCOPE_API_KEY=
DASHSCOPE_CHAT_MODEL=qwen3.7-plus
DASHSCOPE_EMBED_MODEL=qwen3.7-text-embedding

# ========== Ollama（本地，MODEL_PROVIDER=ollama 时生效） ==========
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:0.6b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_TIMEOUT=30

# ========== OpenAI（规划中，接入改造完成前请勿启用） ==========
# 全部使用 OPENAI_ 前缀专属变量，不改动 DashScope 在用的无前缀共享变量
# （CLASSIFIER_MODEL / PLAN_MODEL / VISION_MODEL），因此回滚只需改回 MODEL_PROVIDER。
# 详见 docs/DashScope迁移OpenAI大模型接入设计方案.md §5.6
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1      # 国内服务器需改为中转/代理地址
# OPENAI_CHAT_MODEL=gpt-4.1
# OPENAI_THINKING_MODEL=gpt-5                    # 深度思考（推理模型）；留空则回退主模型
# OPENAI_REASONING_EFFORT=medium                 # low/medium/high，仅推理模型生效
# OPENAI_USE_RESPONSES_API=false                 # true=走 Responses API 展示思考摘要
# OPENAI_OUTPUT_VERSION=                         # 进阶：留空=responses/v1（推荐）
# OPENAI_THINKING_TIMEOUT=300                    # 深度思考专用超时（秒）
# OPENAI_MAX_RETRIES=2                           # 请求重试次数
# OPENAI_EMBED_MODEL=text-embedding-3-large
# OPENAI_EMBED_DIMENSIONS=3072                  # 仅 text-embedding-3-* 有效
# OPENAI_CLASSIFIER_MODEL=gpt-4.1-mini           # 专属变量，勿改无前缀 CLASSIFIER_MODEL
# OPENAI_PLAN_MODEL=gpt-4.1-mini                 # 专属变量，勿改无前缀 PLAN_MODEL
# OPENAI_VISION_MODEL=gpt-4o                     # 专属变量，勿改无前缀 VISION_MODEL

# ========== 轻量模型（Plan-and-Execute 混合路由） ==========
# 分类器模型：用于查询复杂度分类（L1规则 + L2 LLM 判断）
# DashScope 默认 qwen3-flash，Ollama 默认 qwen3:0.6b
# 留空则使用对应 provider 的默认轻量模型
CLASSIFIER_MODEL=qwen3.7-flash-2026-07-15
# Plan 模型：用于 Plan-and-Execute 模式的计划生成阶段
# DashScope 默认 qwen3-flash，Ollama 默认 qwen3:0.6b
# 留空则使用对应 provider 的默认轻量模型
PLAN_MODEL=qwen3.7-flash-2026-07-15

# ========== 思考模式开关（qwen3 系列，默认关闭） ==========
# true=开启思考（质量更高，但延迟大幅增加，规划/分类任务实测超时 30s+）
# false=关闭思考（响应更快，默认推荐）
# 主对话模型的思考模式由前端页面"深度思考"开关控制，无需改这里
PLAN_ENABLE_THINKING=false
CLASSIFIER_ENABLE_THINKING=false

# ========== MySQL ==========
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=raglearn

# ========== Redis ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=
REDIS_PASSWORD=

# ========== 运行环境 ==========
# APP_ENV: development（默认）/ production
# production 时不会自动创建测试用户 admin/admin1234；如需显式创建可设 ENABLE_TEST_USER=true（仅限调试）
APP_ENV=development
ENABLE_TEST_USER=false

# ========== JWT ==========
# 必填：JWT 签名密钥，必须为强随机值（至少 16 字符），启动时若为空或使用公开默认值将拒绝启动
# 生成命令: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========== File Upload ==========
MAX_UPLOAD_SIZE_MB=50
USER_STORAGE_QUOTA_MB=500

# ========== Chat Attachment ==========
# 视觉模型（图片/视频理解）
VISION_MODEL=
OLLAMA_VISION_MODEL=
# 视频理解模式: native=原生视频输入 / frames=抽帧（默认，兼容性最好）
VIDEO_MODE=frames
# 视频抽帧数量
VIDEO_FRAME_COUNT=8
# 图片压缩参数
CHAT_IMAGE_MAX_LONG_EDGE=1568
CHAT_IMAGE_QUALITY=85
# 附件限制
CHAT_IMAGE_MAX_MB=10
CHAT_VIDEO_MAX_MB=50
CHAT_MAX_IMAGES_PER_MSG=6
CHAT_MAX_VIDEOS_PER_MSG=1
# 孤儿附件清理时间（小时）
CHAT_ATTACHMENT_ORPHAN_TTL_HOURS=24

# ========== Chat ==========
REDIS_CHAT_BUFFER_SIZE=10
MAX_CHAT_HISTORY_ROUNDS=20
RAG_ROUTE_THRESHOLD=0.5
# RAG 文档总结开关（true=LLM总结，false=轻量截断，默认 false）
RAG_ENABLE_SUMMARIZE=false
# 默认并行使用 MySQL 关键词召回。设为 false 后重启可回到向量召回。
RAG_KEYWORD_ENABLED=true
# LLM 流式输出超时（秒）
LLM_STREAM_TIMEOUT=120

# ========== AI 联机补全（光标处内联 ghost text） ==========
# 补全专用模型（独立于 CLASSIFIER_MODEL / PLAN_MODEL；须与 pricing.yaml 条目名一字不差）
# AUTOCOMPLETE_MODEL=qwen3.8-flash
# 功能开关（false 时工厂返回 None，前端无补全）
# AUTOCOMPLETE_ENABLED=true
# 调用超时（秒）与生成 token 上限
# AUTOCOMPLETE_TIMEOUT=5.0
# AUTOCOMPLETE_MAX_TOKENS=200
# 光标前上下文上限（字符）与补全结果字符上限
# AUTOCOMPLETE_MAX_CONTEXT=800
# AUTOCOMPLETE_MAX_COMPLETION=200

# ========== AI 自动标签（笔记保存后台生成，失败静默跳过） ==========
# 开关（false 时不调用 LLM，笔记保持用户设置的标签）
AUTO_TAG_ENABLED=true
# 送入模型的正文上限（字符，控制成本；超出部分截断）
AUTO_TAG_MAX_CONTENT_CHARS=1200

# ========== AI 写作辅助（续写 / 扩写 / 摘要，用户主动触发） ==========
# 送入模型的正文上限（字符）
WRITE_ASSIST_MAX_CONTENT_CHARS=3000
# 生成结果上限（字符）
WRITE_ASSIST_MAX_COMPLETION=1200
# 调用超时（秒，主模型推理较慢）
WRITE_ASSIST_TIMEOUT=60

# ========== AI 复习题（每日回顾「AI 出题」，按需触发，6h 缓存） ==========
# 送入模型的笔记正文上限（字符）
REVIEW_QUESTION_MAX_CONTENT_CHARS=2000

# TTS 语音文件清理（TTL 小时 + 每用户文件数配额，生成时 + 每日定时任务兜底）
TTS_FILE_TTL_HOURS=24
TTS_MAX_FILES_PER_USER=50

# ========== CORS ==========
# 生产环境必须配置前端域名白名单（逗号分隔）。
# 注意：使用 * 时系统会自动关闭 allow_credentials（凭据请求不被允许），不建议用于生产。
CORS_ORIGINS=*

# ========== Logging ==========
# LOG_LEVEL: DEBUG（开发，控制台输出）/ INFO（生产，控制台 + 文件滚动）
# LOG_FORMAT: text（开发，纯文本）/ json（生产，结构化）
LOG_LEVEL=DEBUG
LOG_FORMAT=text
# UVICORN_RELOAD: 开发热重载（默认 false，生产必须保持关闭）
UVICORN_RELOAD=false

# ========== Model Trace（P2-2 成本账单 + P2-5 trace 服务化） ==========
# TRACE_SINK: model_trace 输出通道，逗号分隔（log / db / langfuse）
#   log      - 结构化 JSON 日志行（默认，始终可用）
#   db       - 落库 model_traces 表（成本账单聚合数据源）
#   langfuse - 转发 Langfuse trace 平台（需配置下方 LANGFUSE_* 变量）
TRACE_SINK=log,db
# Langfuse trace 平台（自托管或云端，https://langfuse.com 获取密钥）
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# ========== HuggingFace ==========
# 离线模式：阻止从 HuggingFace 在线下载模型（使用本地缓存）
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ========== QQ 邮箱 SMTP 配置 ==========
# SMTP_PASSWORD 为 QQ 邮箱授权码（设置 → 账户 → POP3/SMTP 服务 开启后获取），非登录密码
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USERNAME=you_qq_email    # 备注：要使用自己的qq邮箱测试登录和注册发送邮件的功能请在qq邮箱上开通SMTP服务，当然也可以使用其他邮箱服务商的SMTP服务，修改SMTP_HOST、SMTP_PORT、SMTP_USERNAME、SMTP_PASSWORD即可
SMTP_PASSWORD= ***********
SMTP_FROM_NAME=云尚

# ========== PPT 生成（讲解 PPT 工具，设计方案 §8.3） ==========
# 渲染引擎：python_pptx（本地开源，v1 默认）/ aspose_cloud（Phase 3 云端模板渲染）
PPT_ENGINE=python_pptx
# Aspose.Slides Cloud 凭证（Phase 3 才需要；从 https://dashboard.aspose.cloud 获取 App SID/Key）
ASPOSE_CLIENT_ID=
ASPOSE_CLIENT_SECRET=

# ========== MCP 联网搜索（MCP 专项方案 Part A） ==========
# TAVILY_API_KEY 在 tavily.com 注册获取；未配置时 tavily-mcp 0.2.22 走 keyless 模式（搜索可用，crawl/map/research 不可用）
TAVILY_API_KEY=your_tavily_api_key

# ========== 外部 API 工具（DeepL 翻译 / Wolfram Alpha 计算） ==========
# DEEPL_API_KEY 在 deepl.com/pro-api 注册获取；未配置时翻译工具返回"未配置"提示
DEEPL_API_KEY=your_deepl_api_key
# WOLFRAM_APP_ID 在 developer.wolframalpha.com 注册获取；未配置时计算工具返回"未配置"提示
WOLFRAM_APP_ID=your_wolfram_app_id

# ========== Docker 部署（docker-compose.yml / Dockerfile 构建参数读取） ==========
# 以下变量由 docker compose 自动读取（compose 会在项目根读取 .env 做变量插值），
# 并透传给镜像构建；无需修改 docker-compose.yml 或 Dockerfile。

# ---- 构建加速（国内服务器强烈建议启用，否则 pip / npm 安装极慢甚至失败）----
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# NPM_REGISTRY=https://registry.npmmirror.com

# ---- 前端 nginx 模式 ----
# nginx.conf      默认：80 跳转 443 + TLS，要求 ./certs 下有 fullchain.pem / privkey.pem
# nginx.http.conf 无域名 / 无证书阶段：纯 HTTP，直接可用（SSE 配置已保留）
# NGINX_CONF=nginx.http.conf

# ---- 重排序模型 ----
# 构建期是否预下载重排序模型（约 1GB）。2G 内存服务器必须保持 false，
# 否则容器运行时内存不足会被 OOM Killer 杀掉（模型装不下会自动降级，不影响主流程）
# PRELOAD_MODELS=false
# 模型缓存目录（宿主机路径），挂载到容器 /opt/hf-cache（= 镜像 HF_HOME）
# HF_CACHE_DIR=./huggingface_cache

# ---- 出网代理（仅当需要访问 api.openai.com 等受限服务时启用）----
# 容器内的 httpx 默认 trust_env=True，因此这两个变量会自动生效，代码无需改动。
# 注意：该代理会影响容器内 **所有** HTTPS 出网请求（包括 DashScope），不需要请保持注释。
# 注意：容器内的 127.0.0.1 是容器自身，不是宿主机。若代理跑在宿主机上：
#   - Docker Desktop（Win/Mac）用 http://host.docker.internal:<port>
#   - Linux 服务器用宿主机内网 IP，或 docker 网桥地址 http://172.17.0.1:<port>
#   - 更稳妥的做法是把代理单独跑成一个 compose 服务，然后指向服务名
# HTTPS_PROXY=http://172.17.0.1:7890
# HTTP_PROXY=http://172.17.0.1:7890
# NO_PROXY=localhost,127.0.0.1,mysql,redis,backend,frontend

